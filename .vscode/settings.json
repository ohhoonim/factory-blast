{
  "rust-analyzer.rustfmt.overrideCommand": [
    "leptosfmt",
    "--stdin",
    "--rustfmt"
  ],
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "files.associations": {
    "*.rs": "rust"
  },
  "html.customData": ["./vscode-html-custom-data.json"],
  "editor.quickSuggestions": {
    "strings": true,
    "other": true
  }
}
